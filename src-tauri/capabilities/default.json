{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the always-on-top tile window",
  "windows": ["main", "tile"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-position",
    "autostart:default",
    "notification:default"
  ]
}
